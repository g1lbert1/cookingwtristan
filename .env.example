# Copy to .env. Vite inlines VITE_* vars into the client bundle at build time,
# so everything here ships to the browser and is PUBLIC. Never put a secret here.
VITE_AUTH0_DOMAIN=dev-5jcvwvffofu7udns.us.auth0.com
VITE_AUTH0_CLIENT_ID=IwQeLeWC5LciAJuDz7XsmTc91Gqicjzm
VITE_AUTH0_AUDIENCE=https://cookingwtristan-api.com
VITE_GRAPHQL_URI=http://localhost:4000/graphql

# Public origin of the deployed site, no trailing slash. Used for absolute
# Open Graph URLs (og:url, og:image). Set to the real domain in production.
VITE_SITE_URL=http://localhost:5173
# In production: VITE_SITE_URL=https://cookingwtristan.com
